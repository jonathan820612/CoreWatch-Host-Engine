{
  "productName": "RustCoreWatch",
  "version": "0.1.0",
  "identifier": "com.corewatch.rust.dashboard",
  "build": { "frontendDist": "ui" },
  "app": {
    "withGlobalTauri": true,
    "windows": [{
      "label": "main",
      "title": "RustCoreWatch",
      "decorations": false,
      "visible": false,
      "width": 1080,
      "height": 970,
      "minWidth": 480,
      "minHeight": 520,
      "backgroundColor": "#10131b"
    }],
    "security": {
      "csp": "default-src 'self'; img-src 'self' http://corewatch-wallpaper.localhost; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": { "active": false, "icon": ["icons/icon.ico"] }
}
